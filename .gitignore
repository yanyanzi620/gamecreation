# ===============================================================

# ---------- Godot 4 ----------
.godot/
.import/
export_presets.cfg
*.translation
*.pck

# ---------- Unity 6 ----------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------- 编辑器 / IDE ----------
.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 构建与导出产物 ----------
build/
dist/
out/

# ---------- 操作系统杂项 ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- 临时文件 ----------
*.tmp
*.temp
*.bak
*.log

