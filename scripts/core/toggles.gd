extends RefCounted
class_name Toggles
# ============================================================
# 净化协议 · 后台调试开关
#
# ★ 这里只放「规则开关」（true/false），不放平衡数值 —— 数值在 balance.gd。
# ★ 改完要重启游戏才生效（常量在启动时编译进脚本）。
# ★ 加新开关时，注释里必须写清：true 是什么行为、false 是什么行为、为什么需要它。
# ============================================================


# ------------------------------------------------------------ 射流 vs 阻隔带
# true  = 已生效的阻隔带会截断射流（自己的带子挡自己的弹道，HUD 里 band_clip 计数）
# false = 射流穿过阻隔带，只被肉壁截断（默认）
# 为什么留开关：带子挡弹道更硬核，但铺满之后会把玩家自己的输出也一起封死，
# 上手阶段容易出现「清不掉又打不着」的憋屈感，所以默认放过，需要时再打开。
const JET_BLOCKED_BY_BAND := false


# ------------------------------------------------------------ 跳跃链 vs 阻隔带
# true  = 跳跃链是「空中落点」，直接无视阻隔带（默认，链的唯一反制手段是引信）
# false = 链也会被已生效的带子拦住（闪烁期照旧只减速）
# 为什么默认开着：关掉之后三种病毒的破法就趋同了，链会失去「只能靠引信」的定位。
const CHAIN_IGNORES_BLOCK := true
