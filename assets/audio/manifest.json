    "block_arm": { "files": ["sfx/block_arm.wav"], "volume_db": -6, "pitch_jitter": 0.04, "min_gap_ms": 120 },
    "block_die": { "files": ["sfx/block_die.wav"], "volume_db": -8, "pitch_jitter": 0.05, "min_gap_ms": 300 },
